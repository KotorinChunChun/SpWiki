{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "85e1ddfc-3c81-4cf2-b89f-2638b3c51b34",
  "alias": "SpWikiWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // If true, the component can only be installed on sites where Custom Script is allowed.
  // Components that allow authors to embed arbitrary script code should set this to true.
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "SharePointFullPage"],
  "supportsThemeVariants": true,

  // Lets the web part span the full width of a section, which is what makes a
  // single part app page fill the browser rather than sit in a narrow column.
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
    "group": { "default": "Advanced" },
    "title": { "default": "SpWiki", "ja-jp": "SpWiki" },
    "description": {
      "default": "Displays Markdown files stored in a document library.",
      "ja-jp": "ドキュメントライブラリ内の Markdown ファイルを表示します。"
    },
    "officeFabricIconFontName": "FileCode",
    "properties": {
      "title": "SpWiki",
      "libraryName": "Shared Documents",
      "startFile": "README.md",
      "siteUrl": "",

      "showRelatedPages": true,
      "tagFieldName": "",
      "relatedFolder": "",
      "relatedRecursive": true,
      "relatedMaxItems": 20,

      "showTagEditor": true,
      "showEditButton": true,
      "showPermissionsButton": true,
      "showOpenInAppButton": false,
      "appProtocol": "spmd"
    }
  }]
}
