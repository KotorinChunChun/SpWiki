{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "sp-wiki-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/spWiki/SpWikiWebPart.js",
          "manifest": "./src/webparts/spWiki/SpWikiWebPart.manifest.json"
        }
      ]
    },
    "sp-wiki-command-set": {
      "components": [
        {
          "entrypoint": "./lib/extensions/spWikiCommand/SpWikiCommandSet.js",
          "manifest": "./src/extensions/spWikiCommand/SpWikiCommandSet.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "SpWikiWebPartStrings": "lib/webparts/spWiki/loc/{locale}.js",
    "SpWikiCommandSetStrings": "lib/extensions/spWikiCommand/loc/{locale}.js"
  }
}
